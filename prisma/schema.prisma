}

enum ServiceComboPricingMode {
  FIXED_PRICE
  PERCENT_DISCOUNT
}

enum ServiceComboDurationMode {
  SUM_SERVICES
  CUSTOM
}

// ---------------------------------------------------------------------------
// Lista de espera para dias lotados (ver PLANO_ACAO_LISTA_ESPERA.md)
// ---------------------------------------------------------------------------

enum WaitlistEntryStatus {
  WAITING
  CONVERTED
  CANCELED
  EXPIRED_DAY_PASSED
}

enum WaitlistOfferStatus {
  PENDING
  CONVERTED
  EXPIRED
  DECLINED
  SUPERSEDED
}

enum WaitlistEventType {
  JOINED
  LEFT
  OFFER_SENT
  OFFER_EXPIRED
  OFFER_DECLINED
  CONVERTED
  REMOVED_DAY_PASSED
}

// Um cliente esperando vaga num negócio, numa data.
model WaitlistEntry {
  id                    String              @id @default(cuid())
  businessId            String
  business              Business            @relation(fields: [businessId], references: [id])
  businessCustomerId    String
  businessCustomer      BusinessCustomer    @relation(fields: [businessCustomerId], references: [id])
  personId              String
  person                Person              @relation(fields: [personId], references: [id])
  professionalProfileId String? // null = qualquer profissional serve
  professional          ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id])
  serviceId             String? // null = qualquer serviço
  service               Service?            @relation(fields: [serviceId], references: [id])
  serviceComboId        String? // combo escolhido no lugar de serviço
  serviceCombo          ServiceCombo?       @relation(fields: [serviceComboId], references: [id])
  date                  DateTime            @db.Date // dia no fuso do negócio
  status                WaitlistEntryStatus @default(WAITING)
  // Define a ordem da fila. Reentrar depois de sair reinicia a posição.
  queued_at             DateTime            @default(now())
  converted_appointment_id String?          @unique
  converted_appointment Appointment?        @relation(fields: [converted_appointment_id], references: [id])

  offers WaitlistOffer[]
  events WaitlistEvent[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, personId, date], name: "uq_waitlist_business_person_date")
  @@index([businessId, professionalProfileId, date, status], name: "idx_waitlist_queue")
  @@index([personId, status], name: "idx_waitlist_person_status")
  @@index([date, status], name: "idx_waitlist_date_status")
}

// A vaga específica ofertada a uma entrada, com prazo para aceitar.
model WaitlistOffer {
  id                    String              @id @default(cuid())
  waitlistEntryId       String
  waitlistEntry         WaitlistEntry       @relation(fields: [waitlistEntryId], references: [id])
  businessId            String
  business              Business            @relation(fields: [businessId], references: [id])
  professionalProfileId String
  professional          ProfessionalProfile @relation(fields: [professionalProfileId], references: [id])
  serviceId             String?
  service               Service?            @relation(fields: [serviceId], references: [id])
  serviceComboId        String?
  serviceCombo          ServiceCombo?       @relation(fields: [serviceComboId], references: [id])
  slot_start_at_utc     DateTime
  slot_end_at_utc       DateTime
  status                WaitlistOfferStatus @default(PENDING)
  expires_at_utc        DateTime
  notified_at_utc       DateTime?
  responded_at_utc      DateTime?
  metadata              Json?

  events WaitlistEvent[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, expires_at_utc], name: "idx_waitlist_offer_status_expires")
  @@index([waitlistEntryId], name: "idx_waitlist_offer_entry")
  @@index([professionalProfileId, status, slot_start_at_utc], name: "idx_waitlist_offer_hold")
}

// Log imutável de auditoria.
model WaitlistEvent {
  id              String            @id @default(cuid())
  waitlistEntryId String
  waitlistEntry   WaitlistEntry     @relation(fields: [waitlistEntryId], references: [id])
  offerId         String?
  offer           WaitlistOffer?    @relation(fields: [offerId], references: [id])
  event_type      WaitlistEventType
  by_user_id      String? // null = sistema
  reason          String?
  created_at      DateTime          @default(now())

  @@index([waitlistEntryId, created_at], name: "idx_waitlist_event_entry")
}
